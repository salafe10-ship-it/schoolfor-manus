# Canonical Supabase environment variables.
# Never commit real values to this file.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
DATABASE_URL="<server-side-pooled-connection-string>"
DIRECT_URL="<server-side-direct-connection-string>"
JWT_SECRET="replace-with-a-secret-managed-by-the-deployment-platform"

# Optional SOL/LUNA review-and-implementation workflow (server-side only)
OPENAI_API_KEY="replace-with-server-managed-openai-key"
SOL_MODEL="gpt-5.6-sol"
LUNA_MODEL="gpt-5.6-luna"
