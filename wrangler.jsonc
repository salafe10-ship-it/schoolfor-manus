{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schoolfor-manus",
  "main": "./cloudflare-worker.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "FINANCIAL_WRITES_LOCKED": "false",
    "FINANCIAL_ERP_MODE": "canonical"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "eee116c2737343ed9621cf5e841da91a"
    },
    {
      "binding": "HYPERDRIVE_ADMIN",
      "id": "96f103ef23834120ae4afa2f5df32364"
    }
  ],
  "alias": {
    "body-parser": "./cloudflare/body-parser-shim.js"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
