{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schoolfor-manus",
  "main": "./cloudflare-worker.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // The paid Workers plan must keep enough CPU headroom for the first
  // school-portal request, which initializes the trusted directory connection.
  // Without an explicit limit, a cold request can be terminated at the
  // platform default before the login shell receives its school identity.
  "limits": {
    "cpu_ms": 30000
  },
  "vars": {
    "DATABASE_ROLE_EXPECTED": "edupro_app",
    "EDUPRO_ENVIRONMENT": "production",
    "FINANCIAL_WRITES_LOCKED": "false",
    "FINANCIAL_ERP_MODE": "canonical",
    "PGSSL_REJECT_UNAUTHORIZED": "true",
    "PUBLIC_APP_URL": "https://abdalsalamsoft.com"
  },
  "routes": [
    {
      "pattern": "abdalsalamsoft.com",
      "custom_domain": true
    },
    {
      "pattern": "modern-family-schools.abdalsalamsoft.com",
      "custom_domain": true
    },
    {
      "pattern": "*.abdalsalamsoft.com/*",
      "zone_name": "abdalsalamsoft.com"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "eee116c2737343ed9621cf5e841da91a"
    },
    {
      "binding": "HYPERDRIVE_ADMIN",
      "id": "96f103ef23834120ae4afa2f5df32364"
    }
  ],
  "alias": {
    "body-parser": "./cloudflare/body-parser-shim.js"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
