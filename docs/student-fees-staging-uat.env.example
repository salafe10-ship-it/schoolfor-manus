# Copy to the git-ignored .env.staging file, then fill only from the approved
# staging secret store. This template is for the loopback-only write UAT.
# Never copy DATABASE_URL from the general .env file without verifying its target.
EDUPRO_ENVIRONMENT=staging
UAT35_TARGET=schoolfor-manus-staging
DATABASE_ROLE_EXPECTED=edupro_staging_app
UAT_FINANCIAL_BASE_URL=http://127.0.0.1:4179
UAT_ALLOW_LOCAL_STAGING=false
RUNTIME_SCHEMA_BOOTSTRAP=false
AUTO_MIGRATE=false
AUTO_SEED=false
PGSSL_REJECT_UNAUTHORIZED=true
FINANCIAL_ERP_MODE=canonical
JWT_SECRET=
STUDENT_CERTIFICATE_SIGNING_SECRET=

# Fill from the approved staging secret store and dedicated, clean UAT fixtures.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=
PLATFORM_ADMIN_DATABASE_URL=
UAT_STUDENT_FEES_STAGING_CONFIRM=
UAT_FINANCIAL_BEARER_TOKEN=
UAT_FINANCIAL_STUDENT_ID=
UAT_FINANCIAL_SECOND_STUDENT_ID=
UAT_FINANCIAL_FEE_CONFIG_ID=
UAT_FINANCIAL_FEE_TEMPLATE_ID=
UAT_FINANCIAL_RECEIPT_ACCOUNT=
UAT_FINANCIAL_REVENUE_ACCOUNT=

# Set both only immediately before a local financial UAT run:
# UAT_ALLOW_LOCAL_STAGING=true
# UAT_STUDENT_FEES_STAGING_CONFIRM=RUN_STUDENT_FEES_STAGING_UAT
# The local starter still refuses non-staging database targets and binds only to 127.0.0.1.
# Cloudflare staging remains write-locked; do not use its URL for financial-write UAT.
