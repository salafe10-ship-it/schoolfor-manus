# Production-only template. Store real values in Render or the deployment secret manager.
SUPABASE_URL="https://your-production-project.supabase.co"
SUPABASE_ANON_KEY="your-production-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-production-service-role-key"
DATABASE_URL="<server-side-production-pooled-connection-string>"
DIRECT_URL="<server-side-production-direct-connection-string>"
# The tenant connection must resolve to a non-superuser, non-BYPASSRLS role.
EDUPRO_ENVIRONMENT="production"
DATABASE_ROLE_EXPECTED="edupro_app"
# Required dedicated control-plane connection; never reuse DATABASE_URL here.
PLATFORM_ADMIN_DATABASE_URL="<server-side-production-platform-admin-connection-string>"
PGSSL_REJECT_UNAUTHORIZED="true"
ALLOW_IFRAME_EMBEDDING="false"
EDUPRO_AI_FORECAST_ENABLED="false"
JWT_SECRET="replace-with-a-production-secret"
PUBLIC_APP_URL="https://your-production-domain.example"
# Optional AI assistant integration; keep disabled unless policy and provider are approved.
GEMINI_API_KEY=""
OPENAI_API_KEY=""
